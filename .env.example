# Friend Computer Milestone 2 uses Supabase Realtime for cross-device control.
# The checked-in client configuration targets the dormant GlitterDesk recovery project
# jtbmzdydmxettzqmzgoz so preview builds work without secret configuration.
# These optional variables override that client-public configuration when rotating keys.
NEXT_PUBLIC_SUPABASE_URL=https://jtbmzdydmxettzqmzgoz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role key or database password is required in the browser.
# OpenAI/Resend server credentials arrive in later milestones.
