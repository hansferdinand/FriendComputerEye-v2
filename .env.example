# Friend Computer Milestone 2 uses Supabase Realtime for cross-device control.
# The checked-in client configuration targets the dormant GlitterDesk recovery project
# jtbmzdydmxettzqmzgoz so preview builds work without secret configuration.
# These optional variables override that client-public configuration when rotating keys.
NEXT_PUBLIC_SUPABASE_URL=https://jtbmzdydmxettzqmzgoz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role key or database password is required in the browser.

# Required for persistent GM tools, Mission Director, roster, and session logs.
FRIEND_COMPUTER_GM_KEY=

# Required for Copilot, Realtime voice, and transcription.
OPENAI_API_KEY=

# Optional model overrides. Defaults are defined in the corresponding API routes.
OPENAI_COPILOT_MODEL=
OPENAI_STORY_IMPORT_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# Required for citizen notices and device invitations.
RESEND_API_KEY=

# Canonical origin used in email and invitation links.
FRIEND_COMPUTER_PUBLIC_ORIGIN=https://www.alphacomplex.space
